{
  "venvPath": ".",
  "venv": ".venv",
  "exclude": [
    "**/.venv",
    "**/node_modules",
    "**/__pycache__"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "./backend",
        "./backend/.venv/Lib/site-packages"
      ]
    },
    {
      "root": ".",
      "extraPaths": [
        "."
      ]
    }
  ]
}
